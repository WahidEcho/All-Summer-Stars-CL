# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session-pooler connection string, used to run migrations with psql
SUPABASE_DB_URL=postgresql://postgres.your-project:PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# The event this deployment serves
NEXT_PUBLIC_EVENT_SLUG=swanlake-football-stars-2026

# Public origin, used to build the QR target
NEXT_PUBLIC_SITE_URL=http://localhost:3000
